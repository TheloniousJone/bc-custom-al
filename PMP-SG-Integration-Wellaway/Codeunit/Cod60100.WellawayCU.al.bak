    procedure ImportWellawayPOHeader()
    var
        ImportFileName: Text;
        Buffer: Text;
        ImportStream: InStream;
        TempBlobData: Codeunit "Temp Blob";
        FileCU: Codeunit 419;
        CSVBuffer: Record "CSV Buffer" temporary;
        LinesMod: integer;
        IncomingPOHeader: Record "Incoming Wellaway PO Header";
        DecimalText: Text;
        DecimalValue: Decimal;
        DateText: Text;
        DateValue: Date;
    begin

        FileCU.BLOBImport(TempBlobData, ImportFileName);
        TempBlobData.CreateInStream(ImportStream, TextEncoding::UTF8);
        LinesMod := 0;

        CSVBuffer.DeleteAll();
        CSVBuffer.LoadDataFromStream(ImportStream, ',');

        if CSVBuffer.FindSet() then
            repeat
                if CSVBuffer."Line No." > 1 then // ignore header line
                    begin
                    if Not (DocNoExists(CSVBuffer.GetValueOfLineAt(1))) then begin
                        // CSVBuffer.GetValue(LineNo, FieldNo); // sample
                        IncomingPOHeader.Init;

                        case CSVBuffer."Field No." of
                            1:
                                IncomingPOHeader."Purchase Order ID" := ReplaceString(CSVBuffer.Value, '"', '');
                            2:
                                begin
                                    DateText := ReplaceString(CSVBuffer.Value, '"', '');
                                    if DateText = '' then
                                        DateValue := WorkDate()
                                    else
                                        if Not Evaluate(DateValue, DateText) then
                                            DateValue := WorkDate();

                                    IncomingPOHeader."Transaction Date" := DateValue;
                                end;
                            3:
                                IncomingPOHeader."Physical PO ID" := ReplaceString(CSVBuffer.Value, '"', '');
                            4:
                                IncomingPOHeader."Customer Code" := ReplaceString(CSVBuffer.Value, '"', '');
                            5:
                                IncomingPOHeader."Customer Name" := ReplaceString(CSVBuffer.Value, '"', '');
                            6:
                                IncomingPOHeader."Login ID" := ReplaceString(CSVBuffer.Value, '"', '');
                            7:
                                IncomingPOHeader."Order by " := ReplaceString(CSVBuffer.Value, '"', '');
                            8:
                                IncomingPOHeader."Currency " := ReplaceString(CSVBuffer.Value, '"', '');
                            9:
                                IncomingPOHeader."Terms of Payment " := ReplaceString(CSVBuffer.Value, '"', '');
                            10:
                                IncomingPOHeader."Contact Person" := ReplaceString(CSVBuffer.Value, '"', '');
                            11:
                                IncomingPOHeader."Street Name" := ReplaceString(CSVBuffer.Value, '"', '');
                            12:
                                IncomingPOHeader."Country/Region" := ReplaceString(CSVBuffer.Value, '"', '');
                            13:
                                IncomingPOHeader."Zip Code" := ReplaceString(CSVBuffer.Value, '"', '');
                            14:
                                IncomingPOHeader.Email := ReplaceString(CSVBuffer.Value, '"', '');
                            15:
                                IncomingPOHeader.Telephone := ReplaceString(CSVBuffer.Value, '"', '');
                            16:
                                IncomingPOHeader.Fax := ReplaceString(CSVBuffer.Value, '"', '');
                            17:
                                begin
                                    DecimalText := ReplaceString(CSVBuffer.Value, '"', '');
                                    if DecimalText = '' then
                                        DecimalValue := 0
                                    else
                                        Evaluate(DecimalValue, DecimalText);

                                    IncomingPOHeader."Online Discount Amount" := DecimalValue;
                                end;
                            18:
                                begin
                                    DecimalText := ReplaceString(CSVBuffer.Value, '"', '');
                                    if DecimalText = '' then
                                        DecimalValue := 0
                                    else
                                        Evaluate(DecimalValue, DecimalText);

                                    IncomingPOHeader."Online Discount Percent" := DecimalValue;
                                end;
                            19:
                                IncomingPOHeader."Remarks 1 " := ReplaceString(CSVBuffer.Value, '"', '');
                            20:
                                begin
                                    DateText := ReplaceString(CSVBuffer.Value, '"', '');
                                    if DateText = '' then
                                        DateValue := 0D
                                    else
                                        if Not Evaluate(DateValue, DateText) then
                                            DateValue := 0D;

                                    IncomingPOHeader."Order Date " := DateValue;
                                end;
                            21:
                                begin
                                    DateText := ReplaceString(CSVBuffer.Value, '"', '');
                                    if DateText = '' then
                                        DateValue := 0D
                                    else
                                        if Not Evaluate(DateValue, DateText) then
                                            DateValue := 0D;

                                    IncomingPOHeader."Patient Date of Birth" := DateValue;
                                end;
                            22:
                                begin
                                    if UpperCase(ReplaceString(CSVBuffer.Value, '"', '')) = UpperCase('Male') then
                                        IncomingPOHeader."Patient Gender" := IncomingPOHeader."Patient Gender"::Male
                                    else
                                        IncomingPOHeader."Patient Gender" := IncomingPOHeader."Patient Gender"::Female;
                                end;
                            23:
                                IncomingPOHeader."Patient NRIC/FIN/Passport No." := ReplaceString(CSVBuffer.Value, '"', '');
                            24:
                                IncomingPOHeader."Drug Allergies " := ReplaceString(CSVBuffer.Value, '"', '');
                            25:
                                IncomingPOHeader."Clinic ID" := ReplaceString(CSVBuffer.Value, '"', '');
                            26:
                                IncomingPOHeader."Clinic Full Name" := ReplaceString(CSVBuffer.Value, '"', '');
                            27:
                                IncomingPOHeader."Clinic Branch" := ReplaceString(CSVBuffer.Value, '"', '');
                            28:
                                IncomingPOHeader."Clinic Address Line 1 " := ReplaceString(CSVBuffer.Value, '"', '');
                            29:
                                IncomingPOHeader."Clinic Address Line 2" := ReplaceString(CSVBuffer.Value, '"', '');
                            30:
                                IncomingPOHeader."Clinic Postal Code" := ReplaceString(CSVBuffer.Value, '"', '');
                            31:
                                IncomingPOHeader."Clinic Country " := ReplaceString(CSVBuffer.Value, '"', '');
                            32:
                                IncomingPOHeader."Doctor Full Name" := ReplaceString(CSVBuffer.Value, '"', '');
                            33:
                                IncomingPOHeader."Doctor Mobile Country Code" := ReplaceString(CSVBuffer.Value, '"', '');
                            34:
                                IncomingPOHeader."Doctor Mobile No." := ReplaceString(CSVBuffer.Value, '"', '');
                            35:
                                IncomingPOHeader."Remarks 2" := ReplaceString(CSVBuffer.Value, '"', '');
                        end;

                        if not IncomingPOHeader.Insert() then IncomingPOHeader.Modify();
                    end;
                end;
            until CSVBuffer.Next() = 0;

        /*
        LastLine := CSVBuffer.GetNumberOfLines();

        for Line := 2 to LastLine do begin

            if Not (DocNoExists(CSVBuffer.GetValue(Line, 1))) then begin
                IncomingPOHeader.Init;
                

                DateText := Format(CSVBuffer.GetValue(Line, 2));
                if DateText = '' then
                    DateValue := WorkDate()
                else
                    if Not Evaluate(DateValue, DateText) then
                        DateValue := WorkDate();

                IncomingPOHeader."Transaction Date" := DateValue;

                IncomingPOHeader."Physical PO ID" := CSVBuffer.GetValue(Line, 3);
                IncomingPOHeader."Customer Code" := CSVBuffer.GetValue(Line, 4);
                IncomingPOHeader."Customer Name" := CSVBuffer.GetValue(Line, 5);
                IncomingPOHeader."Login ID" := CSVBuffer.GetValue(Line, 6);
                IncomingPOHeader."Order by " := CSVBuffer.GetValue(Line, 7);
                IncomingPOHeader."Currency " := CSVBuffer.GetValue(Line, 8);
                IncomingPOHeader."Terms of Payment " := CSVBuffer.GetValue(Line, 9);
                IncomingPOHeader."Contact Person" := CSVBuffer.GetValue(Line, 10);
                IncomingPOHeader."Street Name" := CSVBuffer.GetValue(Line, 11);
                IncomingPOHeader."Country/Region" := CSVBuffer.GetValue(Line, 12);
                IncomingPOHeader."Zip Code" := CSVBuffer.GetValue(Line, 13);
                IncomingPOHeader.Email := CSVBuffer.GetValue(Line, 14);
                IncomingPOHeader.Telephone := CSVBuffer.GetValue(Line, 15);
                IncomingPOHeader.Fax := CSVBuffer.GetValue(Line, 16);

                DecimalText := ReplaceString(Format(CSVBuffer.GetValue(Line, 17)), '"', '');
                if DecimalText = '' then
                    DecimalValue := 0
                else
                    Evaluate(DecimalValue, DecimalText);

                IncomingPOHeader."Online Discount Amount" := DecimalValue;

                DecimalText := Format(CSVBuffer.GetValue(Line, 18));
                if DecimalText = '' then
                    DecimalValue := 0
                else
                    Evaluate(DecimalValue, DecimalText);

                IncomingPOHeader."Online Discount Percent" := DecimalValue;

                IncomingPOHeader."Remarks 1 " := CSVBuffer.GetValue(Line, 19);

                DateText := Format(CSVBuffer.GetValue(Line, 20));
                if DateText = '' then
                    DateValue := 0D
                else
                    Evaluate(DateValue, DateText);

                IncomingPOHeader."Order Date " := DateValue;

                DateText := Format(CSVBuffer.GetValue(Line, 21));
                if DateText = '' then
                    DateValue := 0D
                else
                    Evaluate(DateValue, DateText);

                IncomingPOHeader."Patient Date of Birth" := DateValue;

                if UpperCase(CSVBuffer.GetValue(Line, 22)) = UpperCase('Male') then
                    IncomingPOHeader."Patient Gender" := IncomingPOHeader."Patient Gender"::Male
                else
                    IncomingPOHeader."Patient Gender" := IncomingPOHeader."Patient Gender"::Female;

                IncomingPOHeader."Patient NRIC/FIN/Passport No." := CSVBuffer.GetValue(Line, 23);
                IncomingPOHeader."Drug Allergies " := CSVBuffer.GetValue(Line, 24);
                IncomingPOHeader."Clinic ID" := CSVBuffer.GetValue(Line, 25);
                IncomingPOHeader."Clinic Full Name" := CSVBuffer.GetValue(Line, 26);
                IncomingPOHeader."Clinic Branch" := CSVBuffer.GetValue(Line, 27);
                IncomingPOHeader."Clinic Address Line 1 " := CSVBuffer.GetValue(Line, 28);
                IncomingPOHeader."Clinic Address Line 2" := CSVBuffer.GetValue(Line, 29);
                IncomingPOHeader."Clinic Postal Code" := CSVBuffer.GetValue(Line, 30);
                IncomingPOHeader."Clinic Country " := CSVBuffer.GetValue(Line, 31);
                IncomingPOHeader."Doctor Full Name" := CSVBuffer.GetValue(Line, 32);
                IncomingPOHeader."Doctor Mobile Country Code" := CSVBuffer.GetValue(Line, 33);
                IncomingPOHeader."Doctor Mobile No." := CSVBuffer.GetValue(Line, 34);
                IncomingPOHeader."Remarks 2" := CSVBuffer.GetValue(Line, 35);
                IncomingPOHeader.Insert(true);

                LinesMod += 1;
            end;

        end;
        */

        if LinesMod <> 0 then
            Message('%1 headers imported.', LinesMod);

    end;

    procedure ImportWellawayPOLine()
    var
        ImportFileName: Text;
        Buffer: Text;
        ImportStream: InStream;
        TempBlobData: Codeunit "Temp Blob";
        FileCU: Codeunit 419;
        CSVBuffer: Record "CSV Buffer" temporary;
        LinesMod: integer;
        IncomingPOLine: Record "Incoming Wellaway PO Line";
        DecimalText: Text;
        DecimalValue: Decimal;
        DateText: Text;
        DateValue: Date;
    begin

        FileCU.BLOBImport(TempBlobData, ImportFileName);
        TempBlobData.CreateInStream(ImportStream, TextEncoding::UTF8);
        LinesMod := 0;

        CSVBuffer.DeleteAll();
        CSVBuffer.LoadDataFromStream(ImportStream, ',');

        if CSVBuffer.FindSet() then
            repeat
                if CSVBuffer."Line No." > 1 then // ignore header line
                    begin
                    if Not (DocNoExists(CSVBuffer.GetValueOfLineAt(1))) then begin
                        // CSVBuffer.GetValue(LineNo, FieldNo); // sample
                        IncomingPOLine.Init;

                        case CSVBuffer."Field No." of
                            1:
                                begin
                                    IncomingPOLine."Purchase Order ID" := ReplaceString(CSVBuffer.Value, '"', '');
                                    IncomingPOLine."Purchase Line No" := CSVBuffer."Line No." * 10000;
                                end;
                            2:
                                IncomingPOLine."Product Code" := ReplaceString(CSVBuffer.Value, '"', '');
                            3:
                                IncomingPOLine."Product Name " := ReplaceString(CSVBuffer.Value, '"', '');
                            4:
                                begin
                                    DecimalText := ReplaceString(CSVBuffer.Value, '"', '');
                                    if DecimalText = '' then
                                        DecimalValue := 0
                                    else
                                        Evaluate(DecimalValue, DecimalText);

                                    IncomingPOLine."Quantity Ordered" := DecimalValue;
                                end;
                            5:
                                begin
                                    DecimalText := ReplaceString(CSVBuffer.Value, '"', '');
                                    if DecimalText = '' then
                                        DecimalValue := 0
                                    else
                                        Evaluate(DecimalValue, DecimalText);

                                    IncomingPOLine."Bonus Quantity " := DecimalValue;
                                end;
                            6:
                                begin
                                    DecimalText := ReplaceString(CSVBuffer.Value, '"', '');
                                    if DecimalText = '' then
                                        DecimalValue := 0
                                    else
                                        Evaluate(DecimalValue, DecimalText);

                                    IncomingPOLine."Unit Price" := DecimalValue;
                                end;
                            7:
                                IncomingPOLine."UOM Code" := ReplaceString(CSVBuffer.Value, '"', '');
                            8:
                                begin
                                    DateText := ReplaceString(CSVBuffer.Value, '"', '');
                                    if DateText = '' then
                                        DateValue := WorkDate()
                                    else
                                        if Not Evaluate(DateValue, DateText) then
                                            DateValue := WorkDate();

                                    IncomingPOLine."Expiry Date" := DateValue;
                                end;
                            9:
                                IncomingPOLine."Instruction of Use" := ReplaceString(CSVBuffer.Value, '"', '');
                            10:
                                IncomingPOLine."Precautions " := ReplaceString(CSVBuffer.Value, '"', '');
                            11:
                                IncomingPOLine.Remarks := ReplaceString(CSVBuffer.Value, '"', '');
                        end;

                        if not IncomingPOLine.Insert() then IncomingPOLine.Modify();
                    end;
                end;
            until CSVBuffer.Next() = 0;

        if LinesMod <> 0 then
            Message('%1 lines imported.', LinesMod);

    end;

    local procedure DocNoExists(DocNo: Code[20]) doesExist: Boolean
    var
        IncomingPOHeader: Record "Incoming Wellaway PO Header";
    begin
        IncomingPOHeader.reset;
        IncomingPOHeader.SetRange("Purchase Order ID", DocNo);
        if IncomingPOHeader.FindFirst() then
            exit(true)
        else
            exit(false);
    end;

    local procedure ReplaceString(String: Text; FindWhat: Text; ReplaceWith: Text) NewString: Text
    var
        FindPos: Integer;
    begin
        FindPos := STRPOS(String, FindWhat);
        WHILE FindPos > 0 DO BEGIN
            NewString += DELSTR(String, FindPos) + ReplaceWith;
            String := COPYSTR(String, FindPos + STRLEN(FindWhat));
            FindPos := STRPOS(String, FindWhat);
        END;
        NewString += String;
    end;
}
