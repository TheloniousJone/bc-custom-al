                    trigger OnPreDataItem()
                    begin
                        if StatementStyle = StatementStyle::Balance then
                            CurrReport.Break();
                        SetRange("Posting Date", 0D, ToDate);
                        SetRange("Date Filter", 0D, ToDate);
